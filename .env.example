# ==============================================================================
# Construction Equipment Rental Management System (CERMS)
# Example Environment Configuration (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Core Django Configuration
# Change to 'cerms_project.settings.cpanel' when running in cPanel shared/VPS hosting
DJANGO_SETTINGS_MODULE=cerms_project.settings.aws
SECRET_KEY=your-django-secret-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=*

# Timezone & Localization
TIME_ZONE=Asia/Colombo
USE_TZ=True

# Database Configuration (MariaDB 10.11 LTS / InnoDB / utf8mb4)
# In Docker: DB_HOST=mariadb | In Local/cPanel: DB_HOST=127.0.0.1 or localhost
DB_NAME=cerms_db
DB_USER=cerms_user
DB_PASSWORD=cerms_secure_password_2026
DB_HOST=mariadb
DB_PORT=3306

# Environment Feature Toggles
# In AWS/Docker: USE_CELERY=True, USE_S3=True
# In cPanel:     USE_CELERY=False (executes sync/cron), USE_S3=False (uses local media/)
USE_CELERY=True
USE_S3=True

# AWS Cloud & S3 Storage Credentials (Active when USE_S3=True)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=cerms-storage-bucket
AWS_S3_REGION_NAME=ap-south-1

# Redis & Celery Message Broker (Active when USE_CELERY=True)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Outbound Notification & Integration Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=postmaster@cerms.com
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=CERMS Notifications <noreply@cerms.com>

# Third-Party SMS / WhatsApp Gateway Settings (Adapter Pattern)
ACTIVE_SMS_PROVIDER=TWILIO
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
